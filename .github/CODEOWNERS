# CODEOWNERS — FuturePath Employment Hub
# Defines who must review and approve changes to specific parts of the repo.
# Rules are matched top to bottom — the last matching rule wins.
# Docs: https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners

# ─────────────────────────────────────────────
# DEFAULT OWNERS
# Product Owners must approve everything by default
# unless a more specific rule below overrides it
# ─────────────────────────────────────────────
*                               @lcs-cohort-17/product-owners

# ─────────────────────────────────────────────
# CORE CONFIG — PO only
# These files are locked to Product Owners only.
# No one else can approve changes to them.
# ─────────────────────────────────────────────
.github/                        @lcs-cohort-17/product-owners
.gitignore                      @lcs-cohort-17/product-owners
README.md                       @lcs-cohort-17/product-owners
CONTRIBUTING.md                 @lcs-cohort-17/product-owners
pubspec.yaml                    @lcs-cohort-17/product-owners

# ─────────────────────────────────────────────
# APPLICATION CODE
# Scrum Masters and QA can approve PRs from
# developers into QA/staging branches.
# POs retain final merge authority into dev and main.
# ─────────────────────────────────────────────
lib/                            @lcs-cohort-17/product-owners @lcs-cohort-17/scrum-masters-qa

# ─────────────────────────────────────────────
# SCREENS
# Scrum Masters and QA can review and approve
# screen-level changes from developers.
# ─────────────────────────────────────────────
lib/screens/                    @lcs-cohort-17/product-owners @lcs-cohort-17/scrum-masters-qa

# ─────────────────────────────────────────────
# SERVICES / MODELS
# Tighter control — PO approval required
# alongside Scrum Master sign-off for
# data and integration layer changes
# ─────────────────────────────────────────────
lib/services/                   @lcs-cohort-17/product-owners @lcs-cohort-17/scrum-masters-qa
lib/models/                     @lcs-cohort-17/product-owners @lcs-cohort-17/scrum-masters-qa

